# Taleora Environment Variables
# Copy this file to .env and insert your real API keys

# Google Gemini API Key (Required for story generation, prompts, and safety checks)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face Access Token (Optional / Recommended for BLIP verification & HF inference)
# Get a free token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Optional: Default Gemini model (e.g., gemini-2.0-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.0-flash
