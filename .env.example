# Taleora Environment Variables Example
# Copy this file to .env and configure your keys (backend-only, never exposed to users)

# 1. Google Gemini API Key (Required for new story generation, prompts, safety checks)
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Hugging Face Access Token (Optional: enables cloud BLIP & HF SDXL/MusicGen models)
# Get a free read token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# 3. Default Gemini Model (Defaults to gemini-2.5-flash with automatic fallback)
GEMINI_MODEL=gemini-2.5-flash
